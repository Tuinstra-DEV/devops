#!/usr/bin/env bash
set -euo pipefail

engine=/usr/local/libexec/tuinstra-backup/tuinstra_backup.py
config=/etc/tuinstra-backup/worker.json

if [[ "${EUID}" -ne 0 ]]; then
  echo "backup admin failed: privileged wrapper must run through sudo" >&2
  exit 1
fi

resolve_target() {
  case "$1" in
    umami|status) host=tuinstra-prod-01 ;;
    tracker) host=tuinstra-prod-02 ;;
    *)
      echo "backup admin failed: target must be umami, status or tracker" >&2
      exit 2
      ;;
  esac
  app="$1"
}

case "${1:-}" in
  status)
    [[ $# -eq 1 ]] || exit 2
    exec "$engine" --config "$config" inspect
    ;;
  run)
    [[ $# -le 2 ]] || exit 2
    resolve_target "${2:-umami}"
    exec "$engine" --config "$config" run-active --host "$host" --app "$app" --trigger manual
    ;;
  check)
    [[ $# -le 2 ]] || exit 2
    resolve_target "${2:-umami}"
    exec "$engine" --config "$config" check --host "$host" --app "$app"
    ;;
  catalog)
    [[ $# -le 2 ]] || exit 2
    resolve_target "${2:-umami}"
    exec "$engine" --config "$config" catalog --host "$host" --app "$app"
    ;;
  retention)
    [[ $# -le 2 ]] || exit 2
    resolve_target "${2:-umami}"
    exec "$engine" --config "$config" retain-active --host "$host" --app "$app"
    ;;
  restore-test)
    if [[ $# -eq 2 ]]; then
      resolve_target umami
      snapshot="$2"
    elif [[ $# -eq 3 ]]; then
      resolve_target "$2"
      snapshot="$3"
    else
      exit 2
    fi
    [[ "$app" != status ]] || {
      echo "backup admin failed: Status restore uses its isolated DEV-41 drill" >&2
      exit 2
    }
    [[ "$snapshot" == latest || "$snapshot" =~ ^[0-9a-f]{8,64}$ ]] || {
      echo "backup admin failed: invalid snapshot id" >&2
      exit 2
    }
    exec "$engine" --config "$config" restore-test --host "$host" --app "$app" --snapshot "$snapshot"
    ;;
  escrow-recovery-test)
    [[ $# -eq 1 ]] || exit 2
    exec "$engine" --config "$config" escrow-recovery-test
    ;;
  *)
    echo "usage: sudo tuinstra-backup-admin {status|catalog [umami|status|tracker]|run [umami|status|tracker]|check [umami|status|tracker]|retention [umami|status|tracker]|restore-test [umami|tracker] SNAPSHOT|escrow-recovery-test}" >&2
    exit 2
    ;;
esac
