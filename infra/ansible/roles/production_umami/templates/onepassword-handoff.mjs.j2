import process from 'node:process';

const baseUrl = 'http://127.0.0.1:3000';
const input = await new Promise((resolve, reject) => {
  let body = '';
  process.stdin.setEncoding('utf8');
  process.stdin.on('data', chunk => {
    body += chunk;
    if (body.length > 16384) {
      reject(new Error('RPC request exceeds the fixed size limit.'));
    }
  });
  process.stdin.on('end', () => resolve(body));
});
const request = JSON.parse(input);

function exactKeys(value, required) {
  if (!value || typeof value !== 'object' || Array.isArray(value)) {
    throw new Error('RPC request must be an object.');
  }
  const actual = Object.keys(value).sort();
  const expected = [...required].sort();
  if (actual.length !== expected.length || actual.some((key, index) => key !== expected[index])) {
    throw new Error('RPC request fields do not match the fixed operation schema.');
  }
}

function password(value) {
  if (typeof value !== 'string' || value.length < 8 || value.length > 255) {
    throw new Error('Invalid password shape.');
  }
  return value;
}

function bearer(value) {
  if (typeof value !== 'string' || value.length < 10 || value.length > 8192) {
    throw new Error('Invalid bearer token shape.');
  }
  return value;
}

function otp(value) {
  if (typeof value !== 'string' || !/^\d{6}$/.test(value)) {
    throw new Error('Invalid OTP shape.');
  }
  return value;
}

const operations = {
  login(value) {
    exactKeys(value, ['operation', 'password']);
    return {
      path: '/api/auth/login',
      method: 'POST',
      body: { username: 'admin', password: password(value.password) },
    };
  },
  twoFactorInitiate(value) {
    exactKeys(value, ['operation', 'authToken']);
    return {
      path: '/api/2fa/setup/initiate',
      method: 'POST',
      token: bearer(value.authToken),
    };
  },
  twoFactorCancel(value) {
    exactKeys(value, ['operation', 'authToken']);
    return {
      path: '/api/2fa/setup/cancel',
      method: 'POST',
      token: bearer(value.authToken),
    };
  },
  twoFactorConfirm(value) {
    exactKeys(value, ['operation', 'authToken', 'otp']);
    return {
      path: '/api/2fa/setup/confirm',
      method: 'POST',
      token: bearer(value.authToken),
      body: { token: otp(value.otp) },
    };
  },
  twoFactorVerify(value) {
    exactKeys(value, ['operation', 'partialToken', 'otp']);
    return {
      path: '/api/2fa/verify',
      method: 'POST',
      token: bearer(value.partialToken),
      body: { token: otp(value.otp) },
    };
  },
  authVerify(value) {
    exactKeys(value, ['operation', 'authToken']);
    return {
      path: '/api/auth/verify',
      method: 'POST',
      token: bearer(value.authToken),
    };
  },
};

const operation = operations[request.operation];
if (!operation) {
  throw new Error('Unsupported RPC operation.');
}
const spec = operation(request);
const response = await fetch(`${baseUrl}${spec.path}`, {
  method: spec.method,
  signal: AbortSignal.timeout(10000),
  headers: {
    Accept: 'application/json',
    ...(spec.body ? { 'Content-Type': 'application/json' } : {}),
    ...(spec.token ? { Authorization: `Bearer ${spec.token}` } : {}),
  },
  ...(spec.body ? { body: JSON.stringify(spec.body) } : {}),
});
const payload = await response.json().catch(() => ({}));
process.stdout.write(JSON.stringify({ status: response.status, payload }));
