# DEV-26: no HTTP proxy block; Caddy redirects to the same HTTPS host and URI.
marcel.tuinstra.dev {
	encode zstd gzip
	header {
		>Strict-Transport-Security "max-age=31536000"
		>X-Content-Type-Options "nosniff"
		>Referrer-Policy "strict-origin-when-cross-origin"
	}
	reverse_proxy site-marcel:80
}
